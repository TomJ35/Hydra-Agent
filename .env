# Hub WebSocket base URL (manager ajoute /{AGENT_ID} automatiquement)
HUB_URL=ws://host.docker.internal:8000/ws/agent

# Manager identity (represente le "server" cote Hub)
MANAGER_ID=manager-test-01

# Agent identity (plusieurs agents possibles pour un meme manager)
AGENT_ID=agent-test-01

# Seconds between two heartbeat messages
HEARTBEAT_INTERVAL=10

# Reconnect delay when socket is down
RECONNECT_DELAY=30

# Optional query params sent to the hub
# Leave empty to use MANAGER_ID automatically
SERVER_ID=
LLM=
API_NAME=

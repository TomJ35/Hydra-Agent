# Hub WebSocket base URL (manager ajoute /{AGENT_ID} automatiquement)
HUB_URL=ws://host.docker.internal:8000/ws/agent

# Manager identity (represente le "server" cote Hub)
MANAGER_ID=manager-test-01

# Agent identity (plusieurs agents possibles pour un meme manager)
AGENT_ID=agent-test-01
# AGENT_IDS=agent-test-01,agent-test-02
# SERVER_IDS=render-01,render-01
# LLM_LIST=groq,mistral
# API_NAME_LIST=GEMINI,GEMINI
#
# Alternative avancee (prioritaire): JSON liste d'agents avec infos correspondantes
# AGENTS_CONFIG_JSON=[{"agent_id":"agent-test-01","server_id":"render-01","llm":"groq","api_name":"GEMINI"}]

# Seconds between two heartbeat messages
HEARTBEAT_INTERVAL=10

# Reconnect delay when socket is down
RECONNECT_DELAY=30

# Optional query params sent to the hub
# Leave empty to use MANAGER_ID automatically
SERVER_ID=
LLM=
API_NAME=

# Docker runtime creation (used when Hub sends "create_agent" WS command)
DOCKER_AGENT_IMAGE=python:3.11-slim
DOCKER_AGENT_COMMAND=pip install --no-cache-dir websockets && python -u src/agent_manager/manager.py
DOCKER_AGENT_CONTAINER_PREFIX=hydra-agent
# Optional: explicit docker executable path if not in PATH
# DOCKER_BIN=/usr/bin/docker
# Spawned agent mount strategy:
# - If DOCKER_AGENT_USE_VOLUMES_FROM_MANAGER=1, spawned agents reuse manager volumes.
# - Otherwise set DOCKER_AGENT_MOUNT_SOURCE to a host path.
# DOCKER_AGENT_USE_VOLUMES_FROM_MANAGER=1
# DOCKER_MANAGER_CONTAINER_REF=hydra-agent-manager
# Optional overrides:
# DOCKER_AGENT_ENV_FILE=.env
# DOCKER_AGENT_MOUNT_SOURCE=.
# DOCKER_AGENT_MOUNT_TARGET=/app
# DOCKER_AGENT_EXTRA_ARGS=
